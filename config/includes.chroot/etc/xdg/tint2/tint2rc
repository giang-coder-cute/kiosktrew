# ==============================================================================
# Google Book OS — ChromeOS Shelf + Android Navigation Dock (tint2rc)
# ==============================================================================
rounded = 10
background_color = #0f172a 92
border_width = 1
border_color = #334155 80

panel_items = P:P:P:L:T:C
panel_size = 100% 48
panel_margin = 0 0
panel_padding = 12 4 10
panel_position = bottom center horizontal
panel_layer = top
strut_policy = follow_size

# Nut 1: Android BACK (◀)
button_icon = go-previous
button_tooltip = Back (Alt+Left)
button_lclick_command = /usr/local/bin/bookos-android-nav.sh back

# Nut 2: Android HOME (●)
button_icon = go-home
button_tooltip = Home / Desktop (Win+D)
button_lclick_command = /usr/local/bin/bookos-android-nav.sh home

# Nut 3: Android OVERVIEW / RECENT APPS (■)
button_icon = view-grid
button_tooltip = Recent Apps / Overview (Alt+Tab)
button_lclick_command = /usr/local/bin/bookos-android-nav.sh overview

# Launcher Icons: Google Chrome & DeepSeek AI
launcher_icon_size = 30
launcher_item_app = /usr/share/applications/google-chrome.desktop
launcher_item_app = /usr/share/applications/bookos-deepseek.desktop

# Clock & Wired Ethernet Status
time1_format = %H:%M
time1_font = Sans Bold 10
clock_font_color = #f8fafc 100
