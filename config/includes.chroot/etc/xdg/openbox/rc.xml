<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <desktops>
    <number>1</number>
    <names><name>BookOS</name></names>
  </desktops>
  <keyboard>
    <!-- Phim tat giong Windows -->
    <!-- Alt + Tab: Chuyen cua so -->
    <keybind key="A-Tab">
      <action name="NextWindow"><finalactions><action name="Focus"/><action name="Raise"/><action name="Unshade"/></finalactions></action>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"><finalactions><action name="Focus"/><action name="Raise"/><action name="Unshade"/></finalactions></action>
    </keybind>

    <!-- Alt + F4: Dong cua so hien tai -->
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>

    <!-- Phim Windows (Super_L) hoac Win+Space: Mo App Launcher kieu ChromeOS -->
    <keybind key="Super_L">
      <action name="Execute"><command>rofi -show drun -show-icons -theme-str 'window {width: 48%;}'</command></action>
    </keybind>
    <keybind key="W-space">
      <action name="Execute"><command>rofi -show drun -show-icons</command></action>
    </keybind>

    <!-- Win + D: Nut Home kieu Android/Windows (thu nho tat ca cua so) -->
    <keybind key="W-d">
      <action name="ToggleShowDesktop"/>
    </keybind>

    <!-- Win + E: Mo trinh quan ly tep -->
    <keybind key="W-e">
      <action name="Execute"><command>pcmanfm</command></action>
    </keybind>

    <!-- Alt + D: Mo nhanh tro ly DeepSeek AI OS Assistant -->
    <keybind key="A-d">
      <action name="Execute"><command>google-chrome-stable --app=http://127.0.0.1:11435</command></action>
    </keybind>

    <!-- Alt + Left: Dieu huong Back cho cua so dang focus -->
    <keybind key="W-Left">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo"><x>0</x><y>0</y><width>50%</width><height>94%</height></action>
    </keybind>
    <keybind key="W-Right">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo"><x>50%</x><y>0</y><width>50%</width><height>94%</height></action>
    </keybind>
  </keyboard>
</openbox_config>
