# ==============================================================================
# Google Book OS — systemd-networkd Wired-Only Profile
# Policy: ethernet-plus-usblan
# ==============================================================================
[Match]
Name=eth* en* usb* enx*

[Network]
DHCP=ipv4
IPv6AcceptRA=yes
DNS=1.1.1.1
DNS=8.8.8.8
LinkLocalAddressing=ipv4

[DHCPv4]
UseDNS=yes
UseMTU=yes
RouteMetric=10
