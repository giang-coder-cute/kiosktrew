#!/usr/bin/env bash
set -euo pipefail

echo "[BookOS Hook] 1. Tao user mac dinh 'bookos' va cau hinh LightDM Autologin..."
if ! id -u bookos >/dev/null 2>&1; then
  useradd -m -s /bin/bash -G sudo,audio,video,netdev bookos
  echo "bookos:bookos" | chpasswd
  echo "bookos ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/bookos
  chmod 0440 /etc/sudoers.d/bookos
fi

mkdir -p /etc/lightdm/lightdm.conf.d
cat <<'EOF' > /etc/lightdm/lightdm.conf.d/50-bookos-autologin.conf
[Seat:*]
autologin-user=bookos
autologin-user-timeout=0
user-session=openbox
EOF

echo "[BookOS Hook] 2. Cai dat Google Chrome Stable lam trinh duyet mac dinh..."
install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg
echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list
apt-get update -y
apt-get install -y --no-install-recommends google-chrome-stable

update-alternatives --set x-www-browser /usr/bin/google-chrome-stable || true
update-alternatives --set gnome-www-browser /usr/bin/google-chrome-stable || true

echo "[BookOS Hook] 3. Go bo hoan toan Wi-Fi & Bluetooth..."
apt-get purge -y wpasupplicant wireless-tools iw bluez bluetooth blueman network-manager-gnome || true
apt-get autoremove -y
systemctl enable systemd-networkd
systemctl enable systemd-resolved

echo "[BookOS Hook] 4. Cai dat Ollama & moi truong DeepSeek AI (/opt/bookos-ai)..."
curl -fsSL https://ollama.com/install.sh | sh || true

python3 -m venv /opt/bookos-ai/venv
/opt/bookos-ai/venv/bin/pip install --no-cache-dir --upgrade pip
/opt/bookos-ai/venv/bin/pip install --no-cache-dir \
  fastapi uvicorn httpx pillow pydantic

# Che do sieu nhe: Khong dong goi PyTorch (~1.8GB) vao ISO. Tu dong cai Janus-Pro khi nguoi dung dung tinh nang Tao anh.
cat <<'JANUS_EOF' > /opt/bookos-ai/install-janus.sh
#!/usr/bin/env bash
set -e
/opt/bookos-ai/venv/bin/pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu
/opt/bookos-ai/venv/bin/pip install --no-cache-dir "git+https://github.com/deepseek-ai/Janus.git"
JANUS_EOF
chmod +x /opt/bookos-ai/install-janus.sh

# Dich vu nen tu dong tai model DeepSeek nhe (deepseek-r1:1.5b) khi co mang day lan dau
cat <<'EOF' > /etc/systemd/system/bookos-ollama-pull.service
[Unit]
Description=Pull DeepSeek deepseek-r1:1.5b on First Boot
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c "ollama list | grep -q 'deepseek-r1:1.5b' || ollama pull deepseek-r1:1.5b"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

# First-boot systemd script chay tro ly DeepSeek AI cuc bo tren cong 11435
cat <<'EOF' > /etc/systemd/system/bookos-ai.service
[Unit]
Description=Google Book OS DeepSeek Local AI Assistant (Chat, Planner, Janus Image)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=bookos
Environment="DEEPSEEK_TEXT_MODEL=deepseek-r1:1.5b"
Environment="DEEPSEEK_IMAGE_MODEL=deepseek-ai/Janus-Pro-1B"
Environment="OLLAMA_HOST=http://127.0.0.1:11434"
ExecStart=/opt/bookos-ai/venv/bin/uvicorn server:app --host 127.0.0.1 --port 11435
WorkingDirectory=/opt/bookos-ai
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

systemctl enable ollama || true
systemctl enable bookos-ollama-pull.service || true
systemctl enable bookos-ai.service
