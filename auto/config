#!/usr/bin/env bash
set -e

LB_HELP="$(lb config --help 2>&1 || true)"
BOOTLOADER_ARGS=""
if echo "$LB_HELP" | grep -q -- "--bootloaders"; then
  BOOTLOADER_ARGS="--bootloaders syslinux,grub-efi"
elif echo "$LB_HELP" | grep -q -- "--bootloader"; then
  BOOTLOADER_ARGS="--bootloader syslinux"
fi

FIRMWARE_ARGS=""
if echo "$LB_HELP" | grep -q -- "--firmware-chroot"; then
  FIRMWARE_ARGS="--firmware-chroot true"
fi

lb config noauto \
  --mode debian \
  --distribution bookworm \
  --architectures amd64 \
  --linux-flavours amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian" \
  --mirror-chroot "http://deb.debian.org/debian" \
  --mirror-binary "http://deb.debian.org/debian" \
  --binary-images iso-hybrid \
  $BOOTLOADER_ARGS \
  --iso-application "Google Book OS" \
  --iso-volume "GOOGLE_BOOK_OS" \
  --bootappend-live "boot=live components quiet splash locales=vi_VN.UTF-8,en_US.UTF-8 keyboard-layouts=us net.ifnames=0 biosdevname=0" \
  --apt-recommends false \
  --debian-installer false \
  --memtest none \
  $FIRMWARE_ARGS \
  "${@}"
